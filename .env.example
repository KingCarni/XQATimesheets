# Copy this file to .env.local and fill in values from Neon and Auth.js.

# Server only. Use the pooled URL for application queries.
DATABASE_URL="postgresql://..."

# Server only. Use the unpooled URL for Prisma migrations/direct operations.
DATABASE_URL_UNPOOLED="postgresql://..."

# Server only. Required by Auth.js to encrypt/sign session cookies.
# Generate with: npx auth secret
AUTH_SECRET="replace-with-at-least-32-characters"
