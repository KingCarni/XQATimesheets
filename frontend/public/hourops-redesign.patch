+                workflows for readability.
+              </p>
+              <figure>
+                <Image
+                  src="/marketing/timesheet-product.png"
+                  alt="Actual HourOps timesheet showing days of the week, total hours, and an approved week"
+                  width={1735}
+                  height={598}
+                />
+                <figcaption>My Timesheet · approved week</figcaption>
+              </figure>
+              <figure>
+                <Image
+                  src="/marketing/reports-product.png"
+                  alt="Actual HourOps report with total and billable hours, work-type distribution, and employee breakdowns"
+                  width={1351}
+                  height={1288}
+                />
+                <figcaption>Reports · work types, billable hours, and employees</figcaption>
+              </figure>
+            </div>
+          ) : tab === 0 ? (
+            <TimesheetPreview compact />
+          ) : tab === 1 ? (
+            <ApprovalsPreview />
+          ) : (
+            <ReportPreview />
+          )}
+        </div>
+        <div className="ho-tour-bottom">
+          <button
+            onClick={() => setScreens(!screens)}
+            className="ho-text-button"
+            data-testid="tour-actual-screens"
+          >
+            {screens ? "Back to interactive preview" : "See actual product screens"}
+            <ArrowRight size={14} />
+          </button>
+          {demoAction && (
+            <form action={demoAction}>
+              <button
